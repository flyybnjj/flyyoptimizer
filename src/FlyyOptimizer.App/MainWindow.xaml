<Window x:Class="FlyyOptimizer.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlyyOptimizer.App" Style="{StaticResource {x:Type Window}}" Title="FlyyOptimizer" Width="1240" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource Ink}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="216" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid Margin="18,26,18,20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,35"><StackPanel Orientation="Horizontal"><Grid Width="29" Height="29" Margin="0,0,9,0"><Path Stroke="{StaticResource Accent}" StrokeThickness="2.5" Data="M 2,22 L 2,6 L 23,6 M 2,14 L 16,14 M 9,23 L 23,9" /></Grid><TextBlock Text="FlyyOptimizer" FontWeight="Bold" FontSize="19" VerticalAlignment="Center" /></StackPanel><TextBlock Text="Diagnóstico de Windows" Style="{StaticResource Small}" Margin="0,9,0,0" /></StackPanel>
        <ListBox Grid.Row="1" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavigationItem}" AutomationProperties.Name="Vistas del diagnóstico" KeyboardNavigation.DirectionalNavigation="Contained">
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="◈" Width="28" Foreground="{StaticResource Accent}" FontSize="18" /><TextBlock Text="Resumen" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Width="28" FontSize="18" Foreground="{StaticResource Accent}" /><TextBlock Text="Hardware" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="⬡" Width="28" FontSize="18" Foreground="{StaticResource Accent}" /><TextBlock Text="Drivers" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="↗" Width="28" FontSize="18" Foreground="{StaticResource Accent}" /><TextBlock Text="Mejoras" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Width="28" FontSize="20" Foreground="{StaticResource Accent}" /><TextBlock Text="Gaming" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Width="28" FontSize="18" Foreground="{StaticResource Accent}" /><TextBlock Text="Historial" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" /></StackPanel></ListBoxItem>
        </ListBox>
        <StackPanel Grid.Row="3" Margin="12,0"><Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,0"><StackPanel><TextBlock Text="Todo en FlyyOptimizer" FontWeight="SemiBold" /><TextBlock Text="Herramientas y colector incluidos." Style="{StaticResource Small}" Margin="0,5,0,0" /><TextBlock Text="Sin cuenta. Informes y respaldos en este equipo." Style="{StaticResource Small}" Margin="0,12,0,0" /></StackPanel></Border></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="30,27,30,23"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding PageTitle}" Style="{StaticResource Heading}" /><TextBlock Text="{Binding PageDescription}" Style="{StaticResource MutedText}" Margin="0,8,20,0" /><TextBlock Text="{Binding Observation}" Style="{StaticResource Small}" Margin="0,8,0,0" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,4,0,0"><Button Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Margin="0,0,8,0" /><Button Content="Analizar equipo" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Analizar equipo sin modificar ajustes" /></StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{StaticResource ErrorSurface}" BorderBrush="{StaticResource ErrorLine}" BorderThickness="1" CornerRadius="6" Margin="30,0,30,16" Padding="14,10" Visibility="{Binding HasError, Converter={StaticResource Visible}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorText}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /><Button Grid.Column="1" Content="Cerrar aviso" Command="{Binding ClearErrorCommand}" Style="{StaticResource QuietButton}" Margin="12,0,0,0" /></Grid></Border>
      <Border Grid.Row="2" Background="{StaticResource Raised}" CornerRadius="6" Padding="16,13" Margin="30,0,30,16" Visibility="{Binding IsScanning, Converter={StaticResource Visible}}">
        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding ScanStage}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" /><TextBlock Grid.Column="1" Text="{Binding ScanPercentLabel}" Style="{StaticResource Small}" Margin="14,0,0,0" /></Grid><ProgressBar Value="{Binding ScanPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,8" AutomationProperties.Name="Progreso del análisis por pasos completados" /><TextBlock Text="{Binding ScanDetail}" Style="{StaticResource Small}" /><TextBlock Text="{Binding LiveSummary}" Style="{StaticResource Small}" Margin="0,5,0,0" /></StackPanel>
      </Border>
      <TabControl x:Name="Pages" local:Motion.TransitionKey="{Binding SelectedPage}" Grid.Row="3" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="30,0,30,20">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" /></ControlTemplate></TabControl.Template>
        <TabItem Header="Resumen"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <StackPanel>
            <Border Style="{StaticResource Surface}" Visibility="{Binding ShowStart, Converter={StaticResource Visible}}" Margin="0,0,0,18" Padding="28,30">
              <Grid Background="{StaticResource Ink}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Empieza por una observación" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Analiza el hardware, los recursos y los drivers. Al terminar, verás qué conviene revisar y la evidencia de cada recomendación." Style="{StaticResource MutedText}" Margin="0,13,22,20" /><TextBlock Text="El análisis tarda unos segundos y guarda el informe localmente." Style="{StaticResource Small}" /><Button Content="Iniciar análisis" Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,23,0,0" /></StackPanel><Grid Grid.Column="1" Width="140" Height="140" VerticalAlignment="Center"><Ellipse Stroke="{StaticResource Line}" StrokeThickness="1" /><Ellipse Stroke="{StaticResource Line}" StrokeThickness="1" Margin="22" /><Path Stroke="{StaticResource Accent}" StrokeThickness="2" Data="M 25,63 L 48,63 L 59,43 L 75,91 L 89,63 L 113,63" /><Path Stroke="{StaticResource Line}" Data="M 70,0 L 70,24 M 70,116 L 70,140 M 0,70 L 24,70 M 116,70 L 140,70" /></Grid></Grid>
            </Border>
            <StackPanel Visibility="{Binding HasResourceData, Converter={StaticResource Visible}}">
              <Border Style="{StaticResource Surface}" Margin="0,0,0,18">
                <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding MachineTitle}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding DeviceIdentity}" Style="{StaticResource Small}" Margin="0,5,14,0" /><TextBlock Text="{Binding MachineSubtitle}" Style="{StaticResource Small}" Margin="0,5,14,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding SampleDetail}" Style="{StaticResource Small}" VerticalAlignment="Center" TextAlignment="Right" MaxWidth="185" /></Grid>
                  <Grid Margin="0,25,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,21,0"><TextBlock Text="CPU" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding CpuValue}" Style="{StaticResource MetricValue}" /><local:ResourceTrace Height="45" Margin="0,16,0,12" Values="{Binding CpuTrace}" Stroke="{StaticResource Accent}" AutomationProperties.Name="Uso de CPU por muestra" /><TextBlock Text="{Binding CpuName}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" MaxHeight="36" /><TextBlock Text="{Binding CpuTemperature, StringFormat=Temperatura: {0}}" Style="{StaticResource Small}" Margin="0,8,0,0" /></StackPanel>
                    <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,1,0" Padding="21,0"><StackPanel><TextBlock Text="Memoria" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding MemoryValue}" Style="{StaticResource MetricValue}" /><local:ResourceTrace Height="45" Margin="0,16,0,12" Values="{Binding MemoryTrace}" Stroke="{StaticResource MemoryAccent}" AutomationProperties.Name="Uso de memoria por muestra" /><TextBlock Text="{Binding MemoryDetail}" Style="{StaticResource Small}" /><TextBlock Text="{Binding MetricSampleLabel}" Style="{StaticResource Small}" Margin="0,8,0,0" /></StackPanel></Border>
                    <StackPanel Grid.Column="2" Margin="21,0,0,0"><TextBlock Text="GPU" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding GpuValue}" Style="{StaticResource MetricValue}" /><local:ResourceTrace Height="45" Margin="0,16,0,12" Values="{Binding GpuTrace}" Stroke="{StaticResource GpuAccent}" AutomationProperties.Name="Uso de GPU por muestra" /><TextBlock Text="{Binding GpuName}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" MaxHeight="36" /><TextBlock Text="{Binding GpuTemperature, StringFormat=Temperatura: {0}}" Style="{StaticResource Small}" Margin="0,8,0,0" /></StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <StackPanel Visibility="{Binding HasCompletedResult, Converter={StaticResource Visible}}">
              <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Ver mejoras" Command="{Binding NavigateCommand}" CommandParameter="3" Style="{StaticResource QuietButton}" /><StackPanel><TextBlock Text="{Binding FindingsSummary}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Revisa una recomendación o consulta el catálogo del modelo en Drivers." Style="{StaticResource Small}" Margin="0,5,0,0" /></StackPanel></DockPanel><ItemsControl ItemsSource="{Binding HighlightFindings}" ItemTemplate="{StaticResource FindingTemplate}" Margin="0,7,0,0" /><TextBlock Text="No se detectaron alertas en los datos disponibles. Consulta las notas para conocer las fuentes que no respondieron." Style="{StaticResource MutedText}" Margin="0,17,0,0" Visibility="{Binding HasFindings, Converter={StaticResource Visible}, ConverterParameter=inverse}" /></StackPanel></Border>
              <Border Style="{StaticResource Surface}" Margin="0,0,0,18" Visibility="{Binding HasNotes, Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="{Binding NotesSummary}" Style="{StaticResource SectionHeading}" /><ItemsControl ItemsSource="{Binding Snapshot.Notes}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Small}" Margin="0,0,0,7" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
              <Border Style="{StaticResource Surface}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Conserva esta observación" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Los informes contienen hardware y nombres de procesos. Revisa su contenido antes de compartirlos." Style="{StaticResource Small}" Margin="0,7,20,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Exportar JSON" Command="{Binding ExportCommand}" CommandParameter="json" Margin="0,0,8,0" /><Button Content="Exportar Markdown" Command="{Binding ExportCommand}" CommandParameter="markdown" /></StackPanel></Grid></Border>
            </StackPanel>
            </StackPanel>
            <TextBlock Text="Durante el análisis verás muestras reales en vivo. Al terminar se muestran los promedios de esa observación. No disponible indica que una fuente no reportó el dato." Style="{StaticResource Small}" Margin="2,18,2,0" />
          </StackPanel>
        </ScrollViewer></TabItem>
        <TabItem Header="Hardware"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
          <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource Visible}, ConverterParameter=inverse}" Margin="0,8,0,18"><TextBlock Text="Analiza el equipo para reunir su inventario y detectar si es portátil o escritorio." Style="{StaticResource MutedText}" /><Button Content="Analizar equipo" Command="{Binding ScanCommand}" HorizontalAlignment="Left" Margin="0,15,0,0" Style="{StaticResource PrimaryButton}" /></StackPanel>
          <StackPanel Visibility="{Binding HasSnapshot, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Configuración observada" Style="{StaticResource SectionHeading}" /><ItemsControl ItemsSource="{Binding Hardware}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}" /><TextBlock Grid.Column="1" Text="{Binding Value}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Almacenamiento" Style="{StaticResource SectionHeading}" /><DataGrid ItemsSource="{Binding Snapshot.Drives}" MaxHeight="230" AutomationProperties.Name="Unidades y espacio libre"><DataGrid.Columns><DataGridTextColumn Header="Unidad" Binding="{Binding Name}" Width="90" MinWidth="90" /><DataGridTextColumn Header="Etiqueta" Binding="{Binding Label}" Width="*" /><DataGridTextColumn Header="Sistema" Binding="{Binding FileSystem}" Width="95" MinWidth="95" /><DataGridTextColumn Header="Total GB" Binding="{Binding TotalGb, StringFormat=N1}" Width="95" MinWidth="95" /><DataGridTextColumn Header="Libre GB" Binding="{Binding FreeGb, StringFormat=N1}" Width="95" MinWidth="95" /><DataGridTextColumn Header="Libre %" Binding="{Binding FreePercent, StringFormat=N1, TargetNullValue=Sin dato}" Width="95" MinWidth="95" /></DataGrid.Columns></DataGrid></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Ver procesos" Command="{Binding OpenGuideCommand}" CommandParameter="OpenTaskManager" Style="{StaticResource QuietButton}" /><TextBlock Text="Procesos por memoria" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" /></DockPanel><TextBlock Text="Memoria de trabajo en el momento de la adquisición." Style="{StaticResource Small}" Margin="0,0,0,12" /><TextBlock Text="Esta fuente no reportó procesos. Consulta las notas del resumen." Style="{StaticResource Small}" Visibility="{Binding HasProcesses, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><DataGrid ItemsSource="{Binding Snapshot.Processes}" MaxHeight="290" AutomationProperties.Name="Procesos observados"><DataGrid.Columns><DataGridTextColumn Header="Proceso" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="100" MinWidth="100" /><DataGridTextColumn Header="Memoria MB" Binding="{Binding MemoryMb, StringFormat=N1}" Width="150" MinWidth="150" /></DataGrid.Columns></DataGrid></StackPanel></Border>
            <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Red" Style="{StaticResource SectionHeading}" /><TextBlock Text="Esta fuente no reportó adaptadores. Consulta las notas del resumen." Style="{StaticResource Small}" Visibility="{Binding HasNetworks, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><DataGrid ItemsSource="{Binding Snapshot.Networks}" MaxHeight="220" AutomationProperties.Name="Adaptadores de red"><DataGrid.Columns><DataGridTextColumn Header="Adaptador" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="140" MinWidth="140" /><DataGridTextColumn Header="Velocidad Mbps" Binding="{Binding SpeedMbps}" Width="160" MinWidth="160" /></DataGrid.Columns></DataGrid></StackPanel></Border>
            <Border Style="{StaticResource Surface}"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Revisar inicio" Command="{Binding OpenGuideCommand}" CommandParameter="OpenStartup" Style="{StaticResource QuietButton}" /><TextBlock Text="Aplicaciones de inicio" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" /></DockPanel><TextBlock Text="Revisa qué aplicaciones necesitas al iniciar. Su presencia no implica un problema." Style="{StaticResource Small}" Margin="0,0,0,12" /><TextBlock Text="No se registraron aplicaciones en las fuentes consultadas." Style="{StaticResource Small}" Visibility="{Binding HasStartup, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><DataGrid ItemsSource="{Binding Snapshot.Startup}" MaxHeight="260" AutomationProperties.Name="Aplicaciones de inicio"><DataGrid.Columns><DataGridTextColumn Header="Aplicación" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Origen" Binding="{Binding Source}" Width="200" MinWidth="200" /></DataGrid.Columns></DataGrid></StackPanel></Border>
          </StackPanel>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Drivers"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel>
            <TextBlock Text="Drivers oficiales de tu modelo" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="{Binding OemDeviceName}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DeviceIdentity}" Style="{StaticResource Small}" Margin="0,5,0,0" />
            <TextBlock Text="{Binding OemSource}" Style="{StaticResource Small}" Margin="0,5,0,0" />
            <TextBlock Text="{Binding OemStatus}" Style="{StaticResource MutedText}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Margin="0,15,0,0"><Button Content="Buscar por modelo" Command="{Binding SearchOemCommand}" Margin="0,0,8,8" Style="{StaticResource PrimaryButton}" ToolTip="Analiza el equipo o abre una observación para buscar su modelo" ToolTipService.ShowOnDisabled="True" /><Button Content="Abrir portal oficial" Command="{Binding OpenOemPortalCommand}" Margin="0,0,8,8" ToolTip="Disponible después de identificar una fuente oficial" ToolTipService.ShowOnDisabled="True" /><Button Content="Buscar por serie" Command="{Binding SearchOemSerialCommand}" Margin="0,0,0,8" Style="{StaticResource QuietButton}" ToolTip="La serie se consulta únicamente tras analizar este equipo y se envía al fabricante oficial" ToolTipService.ShowOnDisabled="True" /></WrapPanel>
            <TextBlock Text="{Binding SerialNotice}" Style="{StaticResource Small}" />
            <TextBlock Text="{Binding SerialDisplay}" Style="{StaticResource Small}" Margin="0,5,0,0" Visibility="{Binding HasSerialDisplay, Converter={StaticResource Visible}}" />
            <StackPanel Visibility="{Binding HasOemPackages, Converter={StaticResource Visible}}" Margin="0,16,0,0">
              <TextBlock Text="{Binding OemPackageNotice}" Style="{StaticResource Small}" Margin="0,0,0,12" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Filtrar por nombre, categoría o sistema" Style="{StaticResource Small}" Margin="0,0,0,5" /><TextBox Text="{Binding OemSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar catálogo oficial por nombre, categoría, versión o sistema" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding OemFilterSummary}" Style="{StaticResource Small}" VerticalAlignment="Bottom" Margin="14,0,0,10" /></Grid>
              <DataGrid ItemsSource="{Binding OemPackagesView}" SelectedItem="{Binding SelectedOemPackage}" MaxHeight="245" Margin="0,14,0,0" AutomationProperties.Name="Paquetes oficiales para el modelo identificado"><DataGrid.Columns><DataGridTextColumn Header="Paquete" Binding="{Binding Name}" Width="*" MinWidth="220" /><DataGridTextColumn Header="Categoría" Binding="{Binding Category, Converter={StaticResource Known}}" Width="145" /><DataGridTextColumn Header="Versión" Binding="{Binding Version, Converter={StaticResource Known}}" Width="140" /><DataGridTextColumn Header="Fecha" Binding="{Binding ReleaseDate, Converter={StaticResource Known}}" Width="110" /><DataGridTextColumn Header="Sistema" Binding="{Binding OperatingSystem, Converter={StaticResource Known}}" Width="200" /></DataGrid.Columns></DataGrid>
              <TextBlock Text="Selecciona un paquete para revisar su sistema compatible y abrir su fuente oficial." Style="{StaticResource Small}" Margin="0,12,0,0" Visibility="{Binding HasSelectedOemPackage, Converter={StaticResource Visible}, ConverterParameter=inverse}" />
              <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0" Visibility="{Binding HasSelectedOemPackage, Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="{Binding SelectedOemPackage.Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedOemPackage.OperatingSystem, Converter={StaticResource Known}, StringFormat=Sistema compatible: {0}}" Style="{StaticResource Small}" Margin="0,6,0,0" /><TextBlock Text="{Binding SelectedOemPackage.Category, Converter={StaticResource Known}, StringFormat=Categoría: {0}}" Style="{StaticResource Small}" /><TextBlock Text="{Binding SelectedOemPackage.Version, Converter={StaticResource Known}, StringFormat=Versión: {0}}" Style="{StaticResource Small}" /><TextBlock Text="{Binding SelectedOemPackage.ReleaseDate, Converter={StaticResource Known}, StringFormat=Fecha: {0}}" Style="{StaticResource Small}" /><TextBlock Text="{Binding OemSelectedSourceUrl}" Style="{StaticResource Small}" Margin="0,6,0,0" /><Button Content="{Binding OemPackageActionLabel}" Command="{Binding OpenOemPackageCommand}" HorizontalAlignment="Left" Margin="0,13,0,0" ToolTip="Abre el enlace oficial en el navegador; revisa su compatibilidad antes de instalar" ToolTipService.ShowOnDisabled="True" /></StackPanel></Border>
            </StackPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,16" Padding="20,16"><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="Buscar ofertas" Command="{Binding SearchUpdatesCommand}" Style="{StaticResource PrimaryButton}" Margin="18,0,0,0" /><StackPanel><TextBlock Text="Windows Update" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Small}" Margin="0,7,0,0" /></StackPanel></DockPanel><DataGrid ItemsSource="{Binding Updates}" MaxHeight="160" Margin="0,15,0,0" Visibility="{Binding HasUpdates, Converter={StaticResource Visible}}" AutomationProperties.Name="Ofertas de drivers en Windows Update"><DataGrid.Columns><DataGridTextColumn Header="Actualización" Binding="{Binding Title}" Width="*" /><DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="140" MinWidth="140" /><DataGridTextColumn Header="Versión" Binding="{Binding Version, Converter={StaticResource Known}}" Width="130" MinWidth="130" /></DataGrid.Columns></DataGrid></StackPanel></Border>
          <Border Style="{StaticResource Surface}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid Margin="20,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="270" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Inventario de drivers" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding DriverCount}" Style="{StaticResource Small}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Filtrar drivers" Style="{StaticResource Small}" Margin="0,0,0,5" /><TextBox Text="{Binding DriverSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filtrar drivers por dispositivo, fabricante o versión" ToolTip="Filtrar por dispositivo, fabricante, clase o versión" /></StackPanel></Grid>
            <DataGrid Grid.Row="1" MaxHeight="340" ItemsSource="{Binding DriversView}" AutomationProperties.Name="Inventario de drivers" Margin="0,0,0,1"><DataGrid.Columns><DataGridTextColumn Header="Dispositivo" Binding="{Binding DeviceName, Converter={StaticResource Known}, ConverterParameter=Dispositivo sin nombre}" Width="*" MinWidth="220" /><DataGridTextColumn Header="Proveedor" Binding="{Binding Provider, Converter={StaticResource Known}}" Width="140" MinWidth="140" /><DataGridTextColumn Header="Versión" Binding="{Binding Version, Converter={StaticResource Known}}" Width="130" MinWidth="130" /><DataGridTextColumn Header="Fecha" Binding="{Binding Date, Converter={StaticResource Known}}" Width="110" MinWidth="110" /><DataGridTextColumn Header="Firma" Binding="{Binding Signed, Converter={StaticResource Signature}}" Width="95" MinWidth="95" /><DataGridTextColumn Header="Estado" Binding="{Binding ProblemCode, Converter={StaticResource Problem}}" Width="115" MinWidth="115" /><DataGridTextColumn Header="Clase" Binding="{Binding DeviceClass, Converter={StaticResource Known}}" Width="125" MinWidth="125" /><DataGridTemplateColumn Header="Fuente oficial" Width="140" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Fabricante" Command="{Binding DataContext.OpenManufacturerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" MinHeight="30" FontSize="12" ToolTip="Disponible cuando se reconoce un fabricante con fuente oficial" ToolTipService.ShowOnDisabled="True" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
          </Grid></Border>
          <StackPanel Grid.Row="2" Margin="0,14,0,0"><WrapPanel><Button Content="Abrir Windows Update" Command="{Binding OpenGuideCommand}" CommandParameter="OpenWindowsUpdate" Margin="0,0,8,8" /><Button Content="Ver drivers opcionales" Command="{Binding OpenGuideCommand}" CommandParameter="OpenOptionalDrivers" Margin="0,0,0,8" /></WrapPanel><TextBlock Text="La fecha del driver no determina si está desactualizado. La instalación se revisa en Windows Update o con el fabricante." Style="{StaticResource Small}" /></StackPanel>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Mejoras"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Prepara el PC para Fortnite" Style="{StaticResource SectionHeading}" /><TextBlock Text="Detecta el juego, revisa el perfil competitivo y aplica los ajustes seleccionados desde Flyy." Style="{StaticResource Small}" /></StackPanel><Button Grid.Column="1" Content="Optimizar PC para Fortnite" Command="{Binding OpenFortniteCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" /></Grid></Border>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Elige qué cambiar" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Los ajustes conservan su estado anterior. La limpieza elimina solo los archivos que selecciones." Style="{StaticResource Small}" Margin="0,7,0,0" /><TextBlock Text="{Binding Tools.Status}" Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Style.Triggers><DataTrigger Binding="{Binding Tools.HasActionError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorText}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><Button Grid.Column="1" Content="Actualizar ajustes" Command="{Binding Tools.RefreshCommand}" VerticalAlignment="Top" /></Grid>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Respuesta visual de Windows" Style="{StaticResource SectionHeading}" /><ItemsControl ItemsSource="{Binding Tools.ImprovementToggles}" ItemTemplate="{StaticResource OptimizationToggleTemplate}" /><TextBlock Text="Actualiza los ajustes para consultar el estado de las animaciones." Style="{StaticResource Small}" Visibility="{Binding Tools.HasInspection, Converter={StaticResource Visible}, ConverterParameter=inverse}" /></StackPanel></Border>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel x:Name="PowerSection"><TextBlock Text="Plan de energía" Style="{StaticResource SectionHeading}" /><ContentControl Content="{Binding Tools}" ContentTemplate="{StaticResource PowerSchemeTemplate}" /></StackPanel></Border>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel x:Name="StartupSection"><TextBlock Text="Inicio de tu sesión" Style="{StaticResource SectionHeading}" /><TextBlock Text="Entradas Run del usuario actual (HKCU). Retirar conserva la entrada para restaurarla. Otras fuentes de inicio y la aprobación de Windows se gestionan por separado." Style="{StaticResource Small}" Margin="0,0,0,13" /><DataGrid ItemsSource="{Binding Tools.StartupEntries}" SelectedItem="{Binding Tools.SelectedStartup}" MaxHeight="260" AutomationProperties.Name="Seleccionar aplicación de inicio del usuario"><DataGrid.Columns><DataGridTextColumn Header="Aplicación" Binding="{Binding Entry.Name}" Width="*" /><DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="145" MinWidth="145" /><DataGridTextColumn Header="Comando" Binding="{Binding Entry.Command}" Width="2*" /></DataGrid.Columns></DataGrid><TextBlock Text="No hay entradas de inicio disponibles en estas fuentes. Actualiza los ajustes para volver a consultar." Style="{StaticResource Small}" Visibility="{Binding Tools.HasStartup, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><TextBlock Text="{Binding Tools.SelectedStartup.Entry.Command}" Style="{StaticResource Small}" Margin="0,11,0,0" /><Button Content="{Binding Tools.StartupActionLabel}" Command="{Binding Tools.ToggleStartupCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Selecciona una aplicación de la lista" ToolTipService.ShowOnDisabled="True" /></StackPanel></Border>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel x:Name="TemporarySection"><TextBlock Text="Temporales del usuario" Style="{StaticResource SectionHeading}" /><TextBlock Text="Solo archivos de al menos 24 horas. Se omiten vínculos, archivos cambiados o en uso. Los archivos eliminados no se pueden deshacer." Style="{StaticResource Small}" Margin="0,0,0,13" /><WrapPanel><Button Content="Ver archivos para limpiar" Command="{Binding Tools.PreviewTempCommand}" Margin="0,0,8,8" /><Button Content="Seleccionar todos" Command="{Binding Tools.SelectAllTempCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" /><Button Content="Quitar selección" Command="{Binding Tools.ClearTempSelectionCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,8" /></WrapPanel><TextBlock Text="{Binding Tools.CleanupStatus}" Style="{StaticResource Small}" Margin="0,6,0,10" AutomationProperties.LiveSetting="Polite" /><ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Tools.TemporaryFiles}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}" Content="{Binding File.RelativePath}" Foreground="{StaticResource Text}" ToolTip="{Binding File.RelativePath}" AutomationProperties.Name="{Binding File.RelativePath}" Margin="0,0,16,0" /><TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Style="{StaticResource Small}" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="{Binding Tools.TempSelectionSummary}" Style="{StaticResource Small}" Margin="0,7,0,0" Visibility="{Binding Tools.HasPreview, Converter={StaticResource Visible}}" /><Button Content="Eliminar seleccionados" Command="{Binding Tools.CleanTempCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Previsualiza y selecciona archivos antes de eliminar" ToolTipService.ShowOnDisabled="True" /></StackPanel></Border>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Cambios y estado anterior" Style="{StaticResource SectionHeading}" /><TextBlock Text="Deshacer restaura el respaldo guardado. Si otro programa cambió el ajuste, se informa el conflicto para que decidas cómo continuar." Style="{StaticResource Small}" Margin="0,0,0,13" /><ListBox ItemsSource="{Binding Tools.Changes}" SelectedItem="{Binding Tools.SelectedChange}" MaxHeight="260" AutomationProperties.Name="Seleccionar cambio para deshacer"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding AppliedAt, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource Small}" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Tus ajustes aplicados aparecerán aquí con su respaldo. La limpieza de archivos no tiene deshacer." Style="{StaticResource Small}" Visibility="{Binding Tools.HasChanges, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><Button Content="Deshacer cambio seleccionado" Command="{Binding Tools.UndoCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" ToolTip="Selecciona un cambio que conserve su respaldo" ToolTipService.ShowOnDisabled="True" /></StackPanel></Border>
          <Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="Recomendaciones del análisis" Style="{StaticResource SectionHeading}" /><ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}" /><TextBlock Text="Analiza el equipo para recibir recomendaciones basadas en una observación. Las herramientas de arriba ya están disponibles." Style="{StaticResource Small}" Visibility="{Binding HasSnapshot, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><TextBlock Text="Inicio, energía, temporales y Modo Juego se revisan aquí. Los enlaces de Windows y fabricantes abren sus controles oficiales." Style="{StaticResource Small}" Margin="0,12,0,0" /></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Gaming"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0"><StackPanel>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel x:Name="FortniteProfileSection">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Optimizar PC para Fortnite" FontSize="22" FontWeight="SemiBold" Margin="0,0,18,0" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Optimizar PC" Command="{Binding Fortnite.ApplyCommand}" Style="{StaticResource PrimaryButton}" ToolTip="Detecta Fortnite y selecciona al menos un ajuste disponible" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Aplicar los ajustes seleccionados del perfil de Fortnite" /></Grid>
            <TextBlock Text="Un perfil integrado para Windows y Fortnite. Detecta el juego y elige los cambios; cada paso conserva su resultado y respaldo." Style="{StaticResource MutedText}" Margin="0,8,0,15" />
            <WrapPanel><Button Content="Detectar Fortnite" Command="{Binding Fortnite.DetectCommand}" Style="{StaticResource QuietButton}" Margin="0,0,8,8" /><Button Content="Elegir carpeta del juego" Command="{Binding Fortnite.ChooseFolderCommand}" Style="{StaticResource QuietButton}" Margin="0,0,0,8" /></WrapPanel>
            <TextBlock Text="{Binding Fortnite.InstallationMessage}" Style="{StaticResource Small}" Margin="0,4,0,8" />
            <StackPanel Visibility="{Binding Fortnite.HasPreview, Converter={StaticResource Visible}}">
              <TextBlock Text="{Binding Fortnite.InstallPath}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Fortnite.SettingsPath}" Style="{StaticResource Small}" Margin="0,5,0,12" />
              <TextBlock Text="Fortnite está abierto. Cierra el juego para aplicar o restaurar su configuración; los ajustes de Windows disponibles se pueden revisar ahora." Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="{Binding Fortnite.IsGameRunning, Converter={StaticResource Visible}}" />
              <ItemsControl ItemsSource="{Binding Fortnite.Options}" IsEnabled="{Binding IsIdle}"><ItemsControl.ItemTemplate><DataTemplate>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,11">
                  <StackPanel><CheckBox Content="{Binding Option.Title}" IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding Option.Available}" FontWeight="SemiBold" Foreground="{StaticResource Text}" AutomationProperties.Name="{Binding Option.Title}" />
                    <TextBlock Text="{Binding Option.Description}" Style="{StaticResource Small}" Margin="25,6,0,0" />
                    <TextBlock Text="{Binding Option.Status}" Style="{StaticResource Small}" Margin="25,4,0,0" />
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="El preset competitivo reduce la calidad visual. El rendimiento depende del equipo y de la partida; compara la misma escena con las capturas de abajo." Style="{StaticResource Small}" Margin="0,14,0,0" />
              <TextBlock Text="{Binding Fortnite.SelectionSummary}" Style="{StaticResource Small}" Margin="0,9,0,0" />
            </StackPanel>
            <StackPanel Visibility="{Binding Fortnite.IsApplying, Converter={StaticResource Visible}}" Margin="0,14,0,0"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Fortnite.ProgressLabel}" Style="{StaticResource Small}" /><TextBlock Text="{Binding Fortnite.ProgressTitle}" Style="{StaticResource Small}" Margin="0,0,15,0" /></DockPanel><ProgressBar Value="{Binding Fortnite.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0" AutomationProperties.Name="Pasos completados del perfil de Fortnite" /></StackPanel>
            <TextBlock Text="{Binding Fortnite.Status}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Style.Triggers><DataTrigger Binding="{Binding Fortnite.HasActionError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorText}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <ItemsControl ItemsSource="{Binding Fortnite.Steps}" Margin="0,11,0,0" Visibility="{Binding Fortnite.HasResults, Converter={StaticResource Visible}}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Message}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Style.Triggers><DataTrigger Binding="{Binding Success}" Value="False"><Setter Property="Foreground" Value="{StaticResource ErrorText}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <StackPanel Margin="0,15,0,0" Visibility="{Binding Fortnite.HasChanges, Converter={StaticResource Visible}}">
              <TextBlock Text="Restaurar un cambio del perfil" Style="{StaticResource SectionHeading}" />
              <ListBox ItemsSource="{Binding Fortnite.Changes}" SelectedItem="{Binding Fortnite.SelectedChange}" MaxHeight="180" AutomationProperties.Name="Cambios del perfil de Fortnite con respaldo"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding AppliedAt, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource Small}" /><TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
              <Button Content="Restaurar cambio seleccionado" Command="{Binding Fortnite.UndoCommand}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Selecciona un cambio con respaldo" ToolTipService.ShowOnDisabled="True" />
            </StackPanel>
            <TextBlock Text="Modo de renderizado: en Fortnite abre Ajustes → Vídeo → Modo de renderizado, elige Rendimiento si priorizas fluidez y reinicia el juego. Flyy conserva el renderizador que ya usas." Style="{StaticResource Small}" Margin="0,16,0,0" />
          </StackPanel></Border>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel x:Name="GamingSettingsSection"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Ajustes para jugar" Style="{StaticResource SectionHeading}" /><Button Grid.Column="1" Content="Actualizar ajustes" Command="{Binding Tools.RefreshCommand}" Style="{StaticResource QuietButton}" /></Grid><ItemsControl ItemsSource="{Binding Tools.GamingToggles}" ItemTemplate="{StaticResource OptimizationToggleTemplate}" /><TextBlock Text="Desactivar Capturas Xbox afecta las funciones de grabación de Xbox/Game Bar, incluida la grabación en segundo plano. No cambia las capturas de otros programas." Style="{StaticResource Small}" Margin="0,12,0,0" /><TextBlock Text="{Binding Tools.Status}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Style.Triggers><DataTrigger Binding="{Binding Tools.HasActionError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorText}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><WrapPanel Margin="0,14,0,0"><Button Content="Cambios y deshacer" Command="{Binding NavigateCommand}" CommandParameter="3" Style="{StaticResource QuietButton}" Margin="0,0,8,0" /></WrapPanel><Expander Header="Plan de energía del equipo" Margin="0,13,0,0" Foreground="{StaticResource Text}"><ContentControl Content="{Binding Tools}" ContentTemplate="{StaticResource PowerSchemeTemplate}" Margin="0,12,0,0" /></Expander></StackPanel></Border>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18"><StackPanel>
            <TextBlock Text="Medir la fluidez del juego" Style="{StaticResource SectionHeading}" />
            <TextBlock Text="{Binding CollectorStatus}" Style="{StaticResource Small}" Margin="0,0,0,8" />
            <TextBlock Text="Abre tu juego, actualiza los procesos y selecciónalo. La captura se guarda como CSV en este equipo." Style="{StaticResource Small}" />
            <Grid x:Name="CaptureSection" Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Procesos por memoria" Style="{StaticResource Small}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding CaptureProcesses}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedProcess}" AutomationProperties.Name="Elegir proceso real para capturar" MaxDropDownHeight="280" /></StackPanel><Button Grid.Column="1" Content="Actualizar procesos" Command="{Binding RefreshProcessesCommand}" VerticalAlignment="Bottom" Margin="8,0,0,0" /></Grid>
            <TextBlock Text="La lista contiene procesos observados, ordenados por memoria. Actualízala después de abrir tu juego; también puedes escribir su PID." Style="{StaticResource Small}" Margin="0,8,0,0" />
            <WrapPanel Margin="0,16,0,0"><StackPanel Width="130" Margin="0,0,12,8"><TextBlock Text="PID manual" Style="{StaticResource Small}" Margin="0,0,0,6" /><TextBox Text="{Binding ProcessId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="PID manual del juego a capturar" /></StackPanel><StackPanel Width="140" Margin="0,0,12,8"><TextBlock Text="Duración (15–300 s)" Style="{StaticResource Small}" Margin="0,0,0,6" /><TextBox Text="{Binding CaptureDuration, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Duración de captura de 15 a 300 segundos" /></StackPanel><Button Content="Capturar sesión A" Command="{Binding CaptureCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Margin="0,0,8,8" /><Button Content="Buscar PID" Command="{Binding OpenGuideCommand}" CommandParameter="OpenTaskManager" Style="{StaticResource QuietButton}" VerticalAlignment="Bottom" Margin="0,0,0,8" /></WrapPanel>
            <TextBlock Text="{Binding CaptureError}" Foreground="{StaticResource Warning}" Margin="0,8,0,0" Visibility="{Binding HasCaptureError, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite" /><Button Content="Abrir Flyy como administrador" Command="{Binding OpenElevatedCommand}" Visibility="{Binding CanRequestCaptureElevation, Converter={StaticResource Visible}}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="0,10,0,8" ToolTip="Windows pedirá permiso para abrir una nueva ventana. Esta sesión seguirá disponible." AutomationProperties.Name="Abrir una nueva ventana de FlyyOptimizer como administrador" />
            <TextBlock Text="Windows puede requerir ejecutar FlyyOptimizer como administrador para la captura ETW. No necesitas instalar otra aplicación." Style="{StaticResource Small}" Margin="0,4,0,0" />
            <WrapPanel Margin="0,17,0,0"><Button Content="Importar CSV como sesión A" Command="{Binding ImportSessionCommand}" CommandParameter="A" Style="{StaticResource QuietButton}" Margin="0,0,9,8" /><Button Content="Importar CSV como sesión B" Command="{Binding ImportSessionCommand}" CommandParameter="B" Style="{StaticResource QuietButton}" ToolTip="Importa primero la sesión A para poder comparar" ToolTipService.ShowOnDisabled="True" Margin="0,0,0,8" /></WrapPanel><TextBlock Text="Para comparar, repite el juego, escena, resolución y ajustes. Otros procesos pueden afectar el resultado." Style="{StaticResource Small}" Margin="0,4,0,0" />
          </StackPanel></Border>
          <Border Style="{StaticResource Surface}" Margin="0,0,0,18" Visibility="{Binding HasSessionA, Converter={StaticResource Visible}}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sesión A" Style="{StaticResource Small}" /><TextBlock Text="{Binding SessionA.Name}" FontSize="17" FontWeight="SemiBold" Margin="0,5,16,0" /><TextBlock Text="{Binding SessionA.Date}" Style="{StaticResource Small}" Margin="0,5,0,0" /><TextBlock Text="{Binding SessionA.Frames}" Style="{StaticResource Small}" /><TextBlock Text="{Binding SessionA.Session.TimingColumn, StringFormat=Columna: {0}}" Style="{StaticResource Small}" /><TextBlock Text="{Binding SessionA.Source}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" MaxHeight="18" ToolTip="{Binding SessionA.Source}" /></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0" Visibility="{Binding HasSessionB, Converter={StaticResource Visible}}"><TextBlock Text="Sesión B" Style="{StaticResource Small}" /><TextBlock Text="{Binding SessionB.Name}" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="{Binding SessionB.Date}" Style="{StaticResource Small}" Margin="0,5,0,0" /><TextBlock Text="{Binding SessionB.Frames}" Style="{StaticResource Small}" /><TextBlock Text="{Binding SessionB.Session.TimingColumn, StringFormat=Columna: {0}}" Style="{StaticResource Small}" /><TextBlock Text="{Binding SessionB.Source}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" MaxHeight="18" ToolTip="{Binding SessionB.Source}" /></StackPanel></Grid><DataGrid ItemsSource="{Binding GamingMetrics}" Margin="0,20,0,0" AutomationProperties.Name="Métricas y comparación de sesiones"><DataGrid.Columns><DataGridTextColumn Header="Métrica" Binding="{Binding Name}" Width="*" /><DataGridTextColumn Header="Sesión A" Binding="{Binding Baseline}" Width="135" MinWidth="135" /><DataGridTextColumn Header="Sesión B" Binding="{Binding Comparison}" Width="135" MinWidth="135" /><DataGridTextColumn Header="Cambio B − A" Binding="{Binding Difference}" Width="135" MinWidth="135" /></DataGrid.Columns></DataGrid><TextBlock Text="{Binding ComparisonNotice}" Style="{StaticResource Small}" Margin="0,13,0,0" /><TextBlock Text="Frame times de la sesión A" FontWeight="SemiBold" Margin="0,21,0,12" /><local:ResourceTrace Values="{Binding SessionTrace}" Limit="{Binding SessionTraceLimit}" Stroke="{StaticResource Accent}" Height="95" AutomationProperties.Name="Frame times observados en sesión A" /><TextBlock Text="Hasta 180 frames reales distribuidos por la sesión. Escala: de 0 al frame time máximo de la sesión." Style="{StaticResource Small}" Margin="0,9,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Surface}"><StackPanel><TextBlock Text="Cómo leer las métricas" Style="{StaticResource SectionHeading}" /><TextBlock Text="FPS promedio: 1000 / frame time promedio. Frame time: tiempo entre frames, no latencia de entrada. Menor frame time indica mayor fluidez." Style="{StaticResource Small}" /><TextBlock Text="p95 y p99: el 95% y el 99% de los frames quedan por debajo de esos tiempos. 1% low: 1000 / tiempo medio del 1% de frames más lento." Style="{StaticResource Small}" Margin="0,9,0,0" /><TextBlock Text="La comparación muestra diferencias medidas. No demuestra que un ajuste sea su causa." Style="{StaticResource Small}" Margin="0,9,0,0" /></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Historial"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,15"><Button DockPanel.Dock="Right" Content="Actualizar historial" Command="{Binding RefreshHistoryCommand}" /><TextBlock Text="Guardado en %LocalAppData%\FlyyOptimizer" Style="{StaticResource Small}" VerticalAlignment="Center" /></DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Surface}" Margin="0,0,0,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="Observaciones guardadas" Style="{StaticResource SectionHeading}" /><ListBox Grid.Row="1" ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" AutomationProperties.Name="Informes guardados"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding CapturedAt, StringFormat=dd/MM/yyyy HH:mm}" /><TextBlock Grid.Column="1" Text="{Binding CpuName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="12,0" /><TextBlock Grid.Column="2" Text="{Binding FindingCount, StringFormat={}{0} hallazgos}" Style="{StaticResource Small}" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Grid.Row="1" Text="Tu próximo análisis aparecerá aquí. También se guardará si alguna fuente no responde." Style="{StaticResource MutedText}" Visibility="{Binding HasReports, Converter={StaticResource Visible}, ConverterParameter=inverse}" /><Button Grid.Row="2" Content="Abrir observación seleccionada" Command="{Binding LoadReportCommand}" ToolTip="Selecciona una observación en la lista" ToolTipService.ShowOnDisabled="True" HorizontalAlignment="Left" Margin="0,12,0,0" /></Grid></Border>
          <Border Grid.Row="2" Style="{StaticResource Surface}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="Guías abiertas" Style="{StaticResource SectionHeading}" /><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Actions}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,9"><StackPanel><WrapPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,14,0" /><TextBlock Text="{Binding At, StringFormat=dd/MM/yyyy HH:mm}" Style="{StaticResource Small}" /></WrapPanel><TextBlock Text="{Binding Outcome}" Style="{StaticResource Small}" Margin="0,4,0,0" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Grid.Row="1" Text="Cuando abras una guía, su fecha y resultado quedarán registrados aquí." Style="{StaticResource MutedText}" Visibility="{Binding HasActions, Converter={StaticResource Visible}, ConverterParameter=inverse}" /></Grid></Border>
        </Grid></TabItem>
      </TabControl>
      <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Chrome}"><StackPanel><ProgressBar IsIndeterminate="{Binding IsBackgroundBusy}" Value="{Binding ScanPercent, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" /><Grid Margin="30,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" /><TextBlock Grid.Column="1" Text="Informes locales" Style="{StaticResource Small}" Margin="20,0,0,0" /></Grid></StackPanel></Border>
    </Grid>
  </Grid>
</Window>
