<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FlyyOptimizer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Flyy.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Flyy.ico" />
    <ProjectReference Include="../FlyyOptimizer.Core/FlyyOptimizer.Core.csproj" />
    <ProjectReference Include="../FlyyOptimizer.Windows/FlyyOptimizer.Windows.csproj" />
    <ProjectReference Include="../FlyyOptimizer.Gaming/FlyyOptimizer.Gaming.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../README.md')" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../THIRD-PARTY-NOTICES.md')" />
    <Content Include="../../licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/WinUtil/*" Link="tools/WinUtil/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
