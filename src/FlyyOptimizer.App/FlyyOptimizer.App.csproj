<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FlyyOptimizer</AssemblyName>
    <Version>1.0.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Flyy.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Flyy.ico" />
    <ProjectReference Include="../FlyyOptimizer.Core/FlyyOptimizer.Core.csproj" />
    <ProjectReference Include="../FlyyOptimizer.Windows/FlyyOptimizer.Windows.csproj" />
    <ProjectReference Include="../FlyyOptimizer.Gaming/FlyyOptimizer.Gaming.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../README.md" Link="Archivos/README.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('../../README.md')" />
    <Content Include="../../THIRD-PARTY-NOTICES.md" Link="Archivos/THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('../../THIRD-PARTY-NOTICES.md')" />
    <Content Include="../../licenses/**/*" Link="Archivos/licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../assets/WinUtil/*" Link="Archivos/tools/WinUtil/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
